#include <metal_stdlib>
using namespace metal;
kernel void metalmind_kernel(device const float* x, device float* out, constant uint& B, constant uint& D, constant float& epsilon, uint3 tgid [[threadgroup_position_in_grid]], uint3 ltid [[thread_position_in_threadgroup]]) {
    (void)epsilon;
    uint row = tgid.x;
    uint tid = ltid.x;
    if (row >= B) return;
    uint base = row * D;
    uint c0 = tid;
    uint c1 = tid + 256u;
    uint c2 = tid + 512u;
    uint c3 = tid + 768u;
    float v0 = (c0 < D) ? x[base + c0] : 0.0f;
    float v1 = (c1 < D) ? x[base + c1] : 0.0f;
    float v2 = (c2 < D) ? x[base + c2] : 0.0f;
    float v3 = (c3 < D) ? x[base + c3] : 0.0f;
    float localMax = -3.4028235e38f;
    if (c0 < D) localMax = max(localMax, v0);
    if (c1 < D) localMax = max(localMax, v1);
    if (c2 < D) localMax = max(localMax, v2);
    if (c3 < D) localMax = max(localMax, v3);
    threadgroup float red[256];
    red[tid] = localMax;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 128u) red[tid] = max(red[tid], red[tid + 128u]);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 64u) red[tid] = max(red[tid], red[tid + 64u]);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 32u) red[tid] = max(red[tid], red[tid + 32u]);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 16u) red[tid] = max(red[tid], red[tid + 16u]);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 8u) red[tid] = max(red[tid], red[tid + 8u]);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 4u) red[tid] = max(red[tid], red[tid + 4u]);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 2u) red[tid] = max(red[tid], red[tid + 2u]);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 1u) red[tid] = max(red[tid], red[tid + 1u]);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    float rowMax = red[0];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    float e0 = (c0 < D) ? exp(v0 - rowMax) : 0.0f;
    float e1 = (c1 < D) ? exp(v1 - rowMax) : 0.0f;
    float e2 = (c2 < D) ? exp(v2 - rowMax) : 0.0f;
    float e3 = (c3 < D) ? exp(v3 - rowMax) : 0.0f;
    float localSum = e0 + e1 + e2 + e3;
    red[tid] = localSum;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 128u) red[tid] += red[tid + 128u];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 64u) red[tid] += red[tid + 64u];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 32u) red[tid] += red[tid + 32u];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 16u) red[tid] += red[tid + 16u];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 8u) red[tid] += red[tid + 8u];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 4u) red[tid] += red[tid + 4u];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 2u) red[tid] += red[tid + 2u];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 1u) red[tid] += red[tid + 1u];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    float invSum = 1.0f / red[0];
    if (c0 < D) out[base + c0] = float(e0 * invSum);
    if (c1 < D) out[base + c1] = float(e1 * invSum);
    if (c2 < D) out[base + c2] = float(e2 * invSum);
    if (c3 < D) out[base + c3] = float(e3 * invSum);
}
